# ==============================================================================
# E-TAHFIDZ — Environment Configuration Example
# Salin file ini menjadi .env lalu isi kredensial sesuai environment Anda.
# JANGAN PERNAH menyimpan kredensial rahasia di kode frontend (VITE_*).
# ==============================================================================

# 1. Server & Security
PORT=3000
APP_URL="http://localhost:3000"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# 2. Gemini AI (Server-Side Only)
# Di AI Studio, GEMINI_API_KEY disuntikkan otomatis melalui panel Secrets.
GEMINI_API_KEY=""

# 3. Supabase PostgreSQL & Auth (Untuk Deployment Produksi / Migrasi Cloud)
# Lihat file /supabase/migrations/001_etahfidz_schema.sql untuk skema & RLS.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. WhatsApp Gateway (Server-Side Only — Konfigurasi via Admin atau Env)
# Provider yang didukung struktur integrasi: fonnte | wablas | meta_cloud_api
WHATSAPP_GATEWAY_PROVIDER=""
WHATSAPP_GATEWAY_API_URL=""
WHATSAPP_GATEWAY_TOKEN=""
